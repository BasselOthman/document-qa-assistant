# =====================================================================
# Document Q&A Assistant Configuration Environment Variables
# Copy this file to .env and configure your values.
# =====================================================================

# LLM Provider Configuration (OpenAI, Groq, Together, Ollama, etc.)
# OpenAI example:
OPENAI_API_KEY=your-api-key-here
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Groq example (Alternative high-speed inference):
# OPENAI_API_KEY=gsk_your_groq_api_key
# OPENAI_API_BASE=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.1-70b-versatile

# Ollama example (Local self-hosted):
# OPENAI_API_KEY=ollama
# OPENAI_API_BASE=http://localhost:11434/v1
# OPENAI_MODEL=llama3.1

# Document Storage & Indexing Paths
PDF_DATA_DIR=./data
CHROMA_DIR=./data/chroma
CHROMA_COLLECTION=document_qa
BM25_INDEX_PATH=./data/bm25_index.pkl

# Text Chunking Settings
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Retrieval Strategy: dense | hybrid | hybrid_rerank
RETRIEVAL_STRATEGY=dense
TOP_K=4
RERANK_CANDIDATES=15

# Embedding & Reranking Models (FastEmbed ONNX CPU models)
FASTEMBED_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# LangGraph Corrective RAG Workflow
MAX_REWRITES=1

# MLflow Experiment Tracking
MLFLOW_TRACKING_URI=./mlruns
MLFLOW_EXPERIMENT_NAME=document-qa-rag
